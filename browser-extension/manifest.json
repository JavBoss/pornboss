{
  "manifest_version": 3,
  "name": "JavBoss 助手",
  "version": "0.11.0",
  "minimum_chrome_version": "102",
  "description": "JavBoss 浏览器助手，增强 JavBoss 和其他网站的联动。",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.javbus.com/*",
    "https://www.javlibrary.com/*",
    "https://javdb.com/*",
    "https://avsox.click/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "JavBoss 助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.javbus.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content/javbus-parser.js", "content/scrape-content.js"]
    },
    {
      "matches": ["https://www.javlibrary.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content/javlibrary-parser.js", "content/scrape-content.js"]
    },
    {
      "matches": ["https://javdb.com/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content/javdb-parser.js", "content/scrape-content.js"]
    },
    {
      "matches": ["https://avsox.click/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content/avsox-parser.js", "content/scrape-content.js"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content/magnet-download.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.html", "bridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
